{
  "manifest_version": 3,
  "name": "L站舆情仪表",
  "version": "0.2.4",
  "description": "在 linux.do 页面上本地统计文本戾气、阴阳怪气与攻击性浓度。默认不联网，不上传任何内容。",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "L站舆情仪表",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "32": "src/assets/icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://linux.do/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://linux.do/*"
      ],
      "js": [
        "src/model.js",
        "src/version.js",
        "src/classifier.js",
        "src/core.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
